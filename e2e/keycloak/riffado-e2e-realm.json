{
    "realm": "riffado-e2e",
    "enabled": true,
    "sslRequired": "none",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "verifyEmail": false,
    "resetPasswordAllowed": false,
    "roles": {
        "client": {
            "riffado-mcp": [
                {
                    "name": "knowledge:read"
                },
                {
                    "name": "transcripts:read"
                },
                {
                    "name": "summaries:read"
                },
                {
                    "name": "tasks:read"
                },
                {
                    "name": "tasks:write"
                },
                {
                    "name": "mail:read"
                }
            ]
        }
    },
    "clients": [
        {
            "clientId": "riffado",
            "name": "Riffado",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "secret": "riffado-e2e-client-secret",
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": [
                "http://docker:3310/api/auth/oauth2/callback/oidc",
                "http://localhost:3310/api/auth/oauth2/callback/oidc",
                "http://localhost:3000/api/auth/oauth2/callback/oidc"
            ],
            "webOrigins": ["+"],
            "attributes": {
                "pkce.code.challenge.method": "S256"
            }
        },
        {
            "clientId": "riffado-mcp",
            "name": "Riffado MCP",
            "enabled": true,
            "protocol": "openid-connect",
            "bearerOnly": true,
            "publicClient": false,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false
        },
        {
            "clientId": "riffado-mcp-tester",
            "name": "Riffado MCP tester (test only: password grant)",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": true,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": false,
            "fullScopeAllowed": false
        },
        {
            "clientId": "riffado-mcp-bot",
            "name": "Riffado MCP bot",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "secret": "riffado-mcp-bot-secret",
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "defaultClientScopes": [
                "web-origins",
                "acr",
                "profile",
                "roles",
                "basic",
                "email",
                "service_account"
            ]
        }
    ],
    "clientScopeMappings": {
        "riffado-mcp": [
            {
                "client": "riffado-mcp-tester",
                "roles": [
                    "knowledge:read",
                    "transcripts:read"
                ]
            }
        ]
    },
    "users": [
        {
            "username": "alice",
            "email": "alice@example.com",
            "emailVerified": true,
            "firstName": "Alice",
            "lastName": "Example",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "alice-password",
                    "temporary": false
                }
            ],
            "clientRoles": {
                "riffado-mcp": [
                    "knowledge:read",
                    "transcripts:read",
                    "summaries:read",
                    "tasks:read"
                ]
            }
        },
        {
            "username": "bob",
            "email": "bob@example.com",
            "emailVerified": false,
            "firstName": "Bob",
            "lastName": "Example",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "bob-password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "carol",
            "email": "carol@example.com",
            "emailVerified": true,
            "firstName": "Carol",
            "lastName": "Example",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "carol-password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "dave",
            "email": "dave@example.com",
            "emailVerified": false,
            "firstName": "Dave",
            "lastName": "Example",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "dave-password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "service-account-riffado-mcp-bot",
            "enabled": true,
            "serviceAccountClientId": "riffado-mcp-bot",
            "clientRoles": {
                "riffado-mcp": [
                    "knowledge:read",
                    "tasks:read",
                    "tasks:write"
                ]
            }
        }
    ]
}
